  "scripts": {
    "predev": "node scripts/kill-ports.mjs",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "build": "if test \"$NODE_ENV\" = 'production'; then echo 'Build-OK: frontend pre-compilado'; else pnpm exec vite build --config frontend/vite.config.ts; fi",
    "build:hostinger": "echo \"frontend/dist pre-built in ZIP, skipping vite build\"",
    "preview": "vite preview --config frontend/vite.config.ts",
    "dev:server": "node backend/server/index.mjs",
    "dev:web": "vite --config frontend/vite.config.ts",
    "start": "node backend/server/index.mjs"
  },
