# ============================================================
#  .env — Produção (Studio Markin Tattoo)
#  Copie este ficheiro para /var/www/studio-markin/backend/.env
#  e preencha os valores reais.
#  NUNCA commite este ficheiro no Git com dados reais.
# ============================================================

# ── Base de Dados (PostgreSQL) ───────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=studio_user
PGPASSWORD=SENHA_FORTE_AQUI_MinLength20Chars!
PGDATABASE=studio_markin

# ── Servidor ─────────────────────────────────────────────────
PORT=5175
NODE_ENV=production

# ── CORS: domínio do site em produção ────────────────────────
CORS_ORIGINS=https://SEU_DOMINIO.com.br,https://www.SEU_DOMINIO.com.br

# ── Segredos JWT (gere com: openssl rand -base64 48) ─────────
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_FORTE_AQUI
ADMIN_JWT_SECRET=GERE_OUTRA_CHAVE_ALEATORIA_FORTE_AQUI

# ── Senhas do painel admin ───────────────────────────────────
ADMIN_PASS=SenhaAdmin_Forte2025!
JOALHERIA_ADMIN_PASS=SenhaJoalheria_Forte2025!

# ── Email SMTP (Gmail App Password) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=studiostatto@gmail.com
SMTP_PASS=APP_PASSWORD_DO_GMAIL_AQUI
CONTACT_EMAIL=studiostattoadmin@gmail.com

# ── InfinitePay (opcional — para checkout online) ────────────
INFINITEPAY_CLIENT_ID=
INFINITEPAY_CLIENT_SECRET=
